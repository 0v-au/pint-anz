{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pint-anz.0v.com.au/schema/rule-catalogue-entry.json",
  "title": "PINT A-NZ Rule Catalogue Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["official", "coverage", "applicability", "editorial"],
  "properties": {
    "official": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rulesetVersion", "ruleset", "family", "kind", "severity", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rulesetVersion": { "type": "string", "minLength": 1 },
        "ruleset": { "enum": ["pint", "aligned"] },
        "family": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["assert", "report"] },
        "severity": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fixtureIds"],
      "properties": {
        "status": { "enum": ["invalid-covered", "valid-covered", "not-applicable", "blocked", "unreviewed"] },
        "fixtureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdictions", "documentTypes"],
      "properties": {
        "jurisdictions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["AU", "NZ", "A-NZ", "unknown"] } },
        "documentTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["invoice", "credit-note", "unknown"] } }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryTopic", "relatedTopics", "state"],
      "properties": {
        "primaryTopic": { "enum": ["allowances-and-charges", "amounts-and-totals", "attachments", "codelists", "dates-and-periods", "general", "identifiers", "invoice-lines", "parties-and-addresses", "payment", "references", "tax", "unclassified"] },
        "relatedTopics": { "type": "array", "uniqueItems": true, "items": { "enum": ["allowances-and-charges", "amounts-and-totals", "attachments", "codelists", "dates-and-periods", "general", "identifiers", "invoice-lines", "parties-and-addresses", "payment", "references", "tax", "unclassified"] } },
        "state": { "enum": ["pending", "reviewed"] }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "commonCauses", "fix", "affectedTerms", "officialRuleUrl", "failingExample", "correctedExample"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "commonCauses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "fix": { "type": "string", "minLength": 1 },
        "affectedTerms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "officialRuleUrl": { "type": "string", "format": "uri" },
        "failingExample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixtureId", "xml"],
          "properties": {
            "fixtureId": { "type": "string", "minLength": 1 },
            "xml": { "type": "string", "minLength": 1 }
          }
        },
        "correctedExample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xml"],
          "properties": {
            "xml": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "editorial": {
            "properties": { "state": { "const": "reviewed" } },
            "required": ["state"]
          }
        },
        "required": ["editorial"]
      },
      "then": { "required": ["guidance"] }
    }
  ]
}
