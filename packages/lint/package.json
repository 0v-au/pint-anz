{
  "name": "@pint-anz/lint",
  "version": "0.1.0",
  "description": "Validate UBL invoices against PINT A-NZ (Peppol Australia & New Zealand) business rules. Zero-config CLI and library, built for CI.",
  "keywords": [
    "peppol",
    "pint",
    "pint-anz",
    "e-invoicing",
    "einvoicing",
    "ubl",
    "schematron",
    "validation",
    "australia",
    "new-zealand",
    "gst",
    "abn"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pint-anz-lint": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "rulesets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "test:fixtures": "pnpm --filter @pint-anz/conformance test",
    "lint": "eslint src bin",
    "prepack": "pnpm test",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-xml-parser": "^4.5.0",
    "saxon-js": "^2.7.0",
    "xmllint-wasm": "^5.2.0",
    "xslt3": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pint-anz/fixtures": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0"
  },
  "pintAnz": {
    "rulesetVersion": "1.1.2",
    "rulesetStatus": "active",
    "rulesetSource": "https://docs.peppol.eu/poac/aunz/pint-aunz/",
    "rulesetResources": "https://docs.peppol.eu/poac/aunz/pint-aunz/resources.zip",
    "rulesetResourcesSha256": "5750a93fe98c4e1bad1d1030f749a473d4b2c3afc5bdeb5372889804b4273d1a",
    "ubl21Sha256": "60b80d76394a8a2add90723ecb8e0e2e9d826775de9749df37a72d60703f86ed"
  },
  "publishConfig": {
    "access": "public"
  }
}
