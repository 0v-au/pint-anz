{
  "name": "@pint-anz/lookup",
  "version": "0.1.0",
  "description": "Discover Peppol participants and their advertised PINT A-NZ billing capabilities without overstating delivery readiness.",
  "keywords": [
    "peppol",
    "pint",
    "pint-anz",
    "e-invoicing",
    "abn",
    "nzbn",
    "sml",
    "smp"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pint-anz-lookup": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test bin --no-error-on-unmatched-pattern",
    "prepack": "pnpm test",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0"
  },
  "pintAnz": {
    "rulesetVersion": "1.1.2",
    "edecCodeListVersion": "9.7",
    "smlVersion": "1.3.0",
    "smpVersion": "1.4.0",
    "identifierPolicyVersion": "4.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
